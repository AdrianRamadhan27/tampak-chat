TAMPAK_ENV=development
TAMPAK_AUTH_REQUIRED=false
TAMPAK_DATABASE_URL=postgresql://tampak_app:CHANGE_ME@127.0.0.1:55434/tampak
TAMPAK_MIGRATION_DATABASE_URL=postgresql://tampak_owner:CHANGE_ME@127.0.0.1:55434/tampak
TAMPAK_DB_PASSWORD=CHANGE_ME
TAMPAK_APP_DB_PASSWORD=CHANGE_ME
TAMPAK_MASTER_KEY=GENERATE_WITH_BOOTSTRAP
TAMPAK_ADMIN_USERNAME=admin
TAMPAK_ADMIN_PASSWORD=GENERATE_WITH_BOOTSTRAP
TAMPAK_DATA_DIR=./runtime
TAMPAK_WEB_ORIGIN=http://localhost:3010
TAMPAK_API_URL=http://127.0.0.1:8100
TAMPAK_ALLOW_LOCAL_PROVIDERS=true
TAMPAK_OPENROUTER_API_KEY=
TAMPAK_EMBEDDING_BATCH_SIZE=12
TAMPAK_EMBEDDING_INTERVAL_SECONDS=0.2
TAMPAK_CHAT_BASE_URL=https://openrouter.ai/api/v1
TAMPAK_CHAT_MODEL=
TAMPAK_CHAT_API_KEY=
TAMPAK_VISION_MODEL=
TAMPAK_VISION_API_KEY=


# Set automatically by bootstrap for bind-mount ownership.
TAMPAK_LOCAL_UID=1000
TAMPAK_LOCAL_GID=1000
